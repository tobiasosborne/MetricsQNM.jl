Notebook[{

Cell[CellGroupData[{
Cell["\<\
Metric corrections of black holes in Einstein-scalar-Gauss-Bonnet up to 40th \
order in dimensionless spin\
\>", "Title",
 CellChangeTimes->{{3.927622341828418*^9, 3.927622398776394*^9}, 
   3.927623932116815*^9},ExpressionUUID->"77814208-e9e2-45fd-9c44-\
a5615ae7d727"],

Cell["\<\
Supplementary materials to \[OpenCurlyDoubleQuote]Quasi-normal mode \
frequencies and gravitational perturbations of black holes with any \
subextremal spin in modified gravity through METRICS: the scalar-Gauss-Bonnet \
gravity case \[CloseCurlyDoubleQuote] by Adrian K.W. Chung and Nicolas Yunes \
at ICASU and UIUC \
\>", "Subtitle",
 CellChangeTimes->{{3.9276224099751*^9, 3.927622454535042*^9}, 
   3.927623925705353*^9},ExpressionUUID->"5b6dbb44-4272-48e2-8504-\
86a8b9657cb0"],

Cell["\<\
- \[Alpha] is the dimensional coupling constant of EsGB gravity, \[Chi]=Cos[\
\[Theta]], a = dimensionless spin = the angular momentum per unit mass 
- Please contact A.K.W.Chung (akwchung@illinois.edu) if there is any problem\
\>", "Subsection",
 CellChangeTimes->{{3.9276230983823233`*^9, 3.927623131663972*^9}, {
  3.927623900273638*^9, 
  3.927623919284306*^9}},ExpressionUUID->"e02ff7d1-a58d-4707-8d87-\
8c8ed788c237"],

